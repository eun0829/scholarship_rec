# ===== [COMMON] 저장 대상 DB (SCHOLARSHIP_NOTICE 테이블이 있는 DB) =====
# 비밀번호/AI 키는 이 파일에 쓰지 말고 `python set_secret.py` 로 한 번 저장하세요 (DB_PASSWORD, EXT01_DB_PASSWORD, AI_API_KEY)
DB_USER=
DB_DSN=host:1521/service
ORACLE_CLIENT_LIB=            # 11g -> thick 모드. Instant Client 경로 (비워두면 PATH/LD_LIBRARY_PATH 사용)

# ===== [COMMON] NAS 저장 루트 =====
SCHOLARSHIP_NAS_ROOT=/info/ai_bundle/scholarship

# 비밀 파일 위치를 바꾸려면 (기본 ~/.scholarship/secrets.env)
# SCHOLARSHIP_SECRET_FILE=

# ===== [COMMON] AI =====
# 키는 이 파일이 아니라 python set_secret.py AI_API_KEY 로 저장 (TU AI Agent API 키)
# [권장] 게이트웨이 + Claude 네이티브 방식: 이미지/PDF/프롬프트 캐싱을 그대로 지원. 주소는 반드시 /claude 로 끝나야 함
AI_PROVIDER=anthropic
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
AI_MODEL=claude-sonnet-5-5     # Claude Sonnet 5.5. python set_secret.py --models 로 이 키로 쓸 수 있는 모델 확인
# [대안] 게이트웨이 + OpenAI 호환 방식 (아래 두 줄로 바꾸고 위 두 줄은 주석 처리)
# AI_PROVIDER=gateway
# AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
AI_TIMEOUT=300
# AI 응답(JSON) 최대 토큰. 긴 공고가 "응답이 JSON 이 아님"으로 실패하면 올리세요 (응답이 잘리면 자동으로 2배까지 재시도)
# AI_MAX_TOKENS=16000
# AI_MAX_TOKENS_LIMIT=24000
# 이미지를 AI 에 보내지 않으려면 false (이미지 공고는 확인필요로 표시됨)
# AI_VISION=true
# AI_SCHEMA_VERSION=2          # 공고 구조화 형식: 2=기존(기본), 3=항목 사전 기반 확장 조건 (시험 추출로 확인한 뒤에 3 으로)
# ITEM_REGISTRY_FILE=config/item_registry.json
# 필요할 때만: anthropic-beta 헤더 (예: prompt-caching-2024-07-31)
# AI_ANTHROPIC_BETA=

# ===== [EXT01] 학교 장학공지 (홈페이지 DB 조회) =====
# 홈페이지 DB 접속정보. 비워두면 위 DB_* 를 그대로 사용
EXT01_DB_USER=
EXT01_DB_DSN=
EXT01_BBS_SETUP_SEQ=374
EXT01_SITE_BASE=https://tukorea.ac.kr          # 본문 이미지 호출 도메인
EXT01_DOWN_BASE=https://www.tukorea.ac.kr      # 첨부 다운로드 도메인
# 조회 SQL 은 config/ext01_query01.txt (본문), config/ext01_query02.txt (첨부) 파일에서 직접 수정합니다.
# 다른 위치의 파일을 쓰려면:
# EXT01_QUERY01_FILE=
# EXT01_QUERY02_FILE=

# ===== [COMMON] AI 에 보내는 글자 수 상한 (토큰 비용 조절, 필요할 때만 주석 해제) =====
# MAX_CHARS_PER_FILE=20000       # 요강/미분류 문서 1개당
# MAX_CHARS_SECONDARY=4000       # 양식/보조 문서 1개당 (참고용이라 앞부분만)
# MAX_TOTAL_CHARS=60000          # 공고 1건 전체

# ===== [RECOMMEND] 추천 단계 (모두 선택, 기본값 있음) =====
# RECOMMEND_URGENT_DAYS=2              # 마감까지 이 일수 이하면 '마감 임박' 경고
# RECOMMEND_MIN_DAYS_LEFT=0            # 이보다 적게 남은 공고 제외 (0=오늘 마감까지 포함, 1=오늘 마감 제외)
# RECOMMEND_INCLUDE_NEED_REVIEW=true   # 검수 대기 공고 포함 (경고 표시)
# RECOMMEND_DEDUPE=true                # 같은 장학의 원 공고/연장 공고 묶기
# RECOMMEND_MAX_RESULTS=20             # 충족/조건부 각각 최대 개수
# RECOMMEND_REGULAR_TERMS=8            # 정규 학기 수 (v3 판정이 이수학기에서 남은 학기·졸업학기를 계산할 때 사용. 4년제 학사 8)
# RECOMMEND_DEFAULT_GPA_SCALE=4.5      # 학생 프로필에 평점 만점이 없을 때 가정 (본교 기준 확인 필요)
# RECOMMEND_DEFER_KEYS=region          # 코드가 탈락시키지 않고 '확인 필요'로 남길 조건 (나중에 AI 프롬프트로 판단). 쉼표로 여러 개:
#                                      #   levels, grade, enrollment, gpa, credits, income, region, nationality, major, special, other, exclusion
# 학교 고정 속성 (학생 프로필에 없을 때 채움 -> 불필요한 '확인 필요' 감소)
# RECOMMEND_SCHOOL_TYPE=GENERAL        # GENERAL(일반대학) / COLLEGE(전문대학)
# RECOMMEND_SCHOOL_SIDO=경기도
# RECOMMEND_SCHOOL_SIGUNGU=시흥시
# RECOMMEND_SCHOOL_PROGRAMS=NATIONAL_SCHOLARSHIP   # 본교가 참여하는 사업(쉼표로 여러 개): NATIONAL_SCHOLARSHIP(국가장학금) / LOCAL_TALENT(지역인재) / HOUSING_STABILITY(주거안정). 비우면 '설정 없음'

# ===== [EXT02] 외부02 드림스폰 (모두 선택, 기본값 있음) =====
# 계정은 이 파일이 아니라 python set_secret.py DREAMSPON_ID / DREAMSPON_PASSWORD 로 저장 (수집 전용 계정 권장)
# 수집 범위/간격/접수방법 키워드는 config/ext02.json 에서 바꿉니다.
# EXT02_ATTACH_TO_AI=guide_only     # 첨부를 AI 에 보내는 범위: guide_only(공고문만, 기본) / guide_and_form(양식 포함) / none(저장만)
# EXT02_BASE_URL=                   # 테스트용 주소 변경 (기본 https://www.dreamspon.com)
# EXT02_CONFIG_FILE=                # 다른 설정 파일 사용 시
