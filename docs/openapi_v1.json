   "RecommendRequest": {
    "type": "object",
    "required": [
     "profile"
    ],
    "properties": {
     "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$",
      "description": "호출하는 쪽이 정하는 요청 번호 (응답과 오류에 그대로 돌려준다). 학번 등 학생을 알 수 있는 값을 쓰지 않는다"
     },
     "profile": {
      "$ref": "#/components/schemas/Profile"
     },
     "answers": {
      "$ref": "#/components/schemas/Profile",
      "description": "이번 회차에 학생이 새로 답한 값 (후속 질문의 answer.keys). profile 의 같은 키를 덮어쓴다"
     },
     "answers_text": {
      "type": "string",
      "maxLength": 5000,
      "description": "답을 `- 라벨: 값` 줄로 보낼 때 (개발·시험용)"
     },
     "declined": {
      "type": "array",
      "maxItems": 60,
      "items": {
       "type": "string",
       "maxLength": 24
      },
      "description": "학생이 건너뛴 항목 코드. 다시 묻지 않는다"
     },
     "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1,
      "description": "몇 번째 질문 회차인지. 질문은 최대 3회"
     },
     "max_questions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5,
      "description": "한 번에 묻는 최대 질문 수"
     },
     "today": {
      "type": "string",
      "format": "date",
      "description": "판정 기준일 (시험용. 보내지 않으면 서버의 오늘)"
