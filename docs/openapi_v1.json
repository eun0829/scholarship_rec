{
 "openapi": "3.1.0",
 "info": {
  "title": "장학금 추천 API",
  "version": "1.0.0",
  "description": "학생 프로필을 받아 장학금 공고와 비교한 판정(충족·조건부·미달)과 후속 질문을 돌려준다. 서버는 학생 정보를 저장하지 않는다. 설명: docs/api_contract_v1.md, docs/result_format_v1.md"
 },
 "security": [
  {
   "ApiKey": []
  }
 ],
 "paths": {
  "/v1/recommend": {
   "post": {
    "operationId": "recommend",
    "summary": "판정과 후속 질문 (1차와 이어 답하는 호출 모두)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/RecommendRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "판정 결과",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RecommendResponse"
        }
       }
      }
     },
     "400": {
      "description": "요청 형식 오류(INVALID_REQUEST) 또는 프로필 항목 간 모순(INVALID_PROFILE)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "API 키 없음 또는 불일치(UNAUTHORIZED)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "413": {
      "description": "요청이 너무 큼(PAYLOAD_TOO_LARGE)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "서버 오류(INTERNAL, SERVER_CONFIG)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "공고 DB를 읽을 수 없음(UNAVAILABLE)",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/health": {
   "get": {
    "operationId": "health",
    "summary": "상태 점검 (6-B 에서 구현)",
    "responses": {
     "200": {
      "description": "상태",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/v1/meta": {
   "get": {
    "operationId": "meta",
    "summary": "버전과 한도 (6-B 에서 구현)",
    "responses": {
     "200": {
      "description": "정보",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Meta"
        }
       }
      }
     }
    }
   }
  }
 },
